; RO Core Client - Godot 4.2 Project Configuration
; Ragnarok Online 2004-inspired 2D MMORPG Client

config_version=5

[application]

config/name="RO Core Client"
config/description="Ragnarok Online 2004-inspired 2D MMORPG Client - Milestone 1"
run/main_scene="res://src/scenes/LoginScreen.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/autoload/GameState.gd"
NetworkManager="*res://src/autoload/NetworkManager.gd"
PacketHandler="*res://src/autoload/PacketHandler.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

